# Copy this file to .env.local and update values with backend details.
# Current verified backend environment:
VITE_API_BASE_URL=http://192.168.0.19:8080/cube
VITE_AUTH_LOGIN_ENDPOINT=/api/v1/auth/login
VITE_AUTH_LOGOUT_ENDPOINT=/api/auth/logout

# Example for VPN or other environment:
# VITE_API_BASE_URL=https://10.20.30.40:8443/cube
# VITE_AUTH_LOGIN_ENDPOINT=/api/v1/auth/login
