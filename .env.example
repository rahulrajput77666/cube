# Copy this file to .env.local and set your backend URL without hardcoded local paths.
# Example values:
# VITE_API_BASE_URL=http://localhost:8080/cube
# VITE_API_BASE_URL=https://app.example.com/cube
VITE_API_BASE_URL=http://192.168.0.19:8080/cube
VITE_AUTH_LOGIN_ENDPOINT=/api/v1/auth/login
VITE_AUTH_LOGOUT_ENDPOINT=/api/auth/logout
